# === App ===
APP_NAME=sap_proposal
VERSION=1.0.0
DEBUG=true

# === Database ===
DATABASE_URL=postgresql+asyncpg://sap_proposal:secret@localhost:5432/sap_proposal

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
JWT_SECRET=change-me-in-production

# === Agent Hub ===
AGENT_HUB_API_URL=https://app.ai-garage.com.br
AGENT_HUB_API_KEY=
AGENT_HUB_HMAC_SECRET=

# === SAP Domain ===
SAP_DEFAULT_TARIFF_PER_HOUR=230
SAP_DEMO_MODE_ENABLED=true

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
